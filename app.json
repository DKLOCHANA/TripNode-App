{
  "expo": {
    "name": "TripNode",
    "slug": "tripnode",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "tripnode",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripnode.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We need your location to help you find places for your trips",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to help you find places for your trips",
        "NSUserTrackingUsageDescription": "This allows TripNode to provide you with a more personalized experience and measure the effectiveness of our campaigns.",
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork" },
          { "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork" },
          { "SKAdNetworkIdentifier": "p78axxw29g.skadnetwork" },
          { "SKAdNetworkIdentifier": "cp8zw746q7.skadnetwork" },
          { "SKAdNetworkIdentifier": "c6k4g5qg8m.skadnetwork" },
          { "SKAdNetworkIdentifier": "s39g8k73mm.skadnetwork" },
          { "SKAdNetworkIdentifier": "3qy4746246.skadnetwork" },
          { "SKAdNetworkIdentifier": "hs6bdukanm.skadnetwork" }
        ]
      },
      "buildNumber": "15",
      "appleTeamId": "CLNUVH5GRA"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-apple-authentication",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "react-native-appsflyer",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This allows TripNode to provide you with a more personalized experience and measure the effectiveness of our campaigns."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A84FF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f48bde9-60e9-4510-b487-1447d031f3b9"
      }
    },
    "owner": "kavindu_k",
    "android": {
      "package": "com.tripnode.app"
    }
  }
}
